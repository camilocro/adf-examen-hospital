{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_billing_sql",
						"type": "DatasetReference"
					},
					"name": "bronze"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "admisionesSilver"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "silverBilling"
				}
			],
			"transformations": [
				{
					"name": "limpiarTextos"
				},
				{
					"name": "convertirMontoFecha"
				},
				{
					"name": "existeAdmision"
				},
				{
					"name": "soloValidos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronze",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> admisionesSilver",
				"bronze derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          montoTexto = regexReplace(coalesce(amount, ''), '[^0-9.-]', ''),",
				"          charge_type = iif(trim(coalesce(charge_type, '')) == '', 'Unknown', trim(charge_type)),",
				"          payment_status = initCap(lower(trim(payment_status)))) ~> limpiarTextos",
				"limpiarTextos derive(amount = toDecimal(round(abs(toDouble(montoTexto)), 2), 12, 2),",
				"          payment_date = case(regexMatch(trim(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'yyyy-MM-dd'), regexMatch(trim(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(payment_date), 'MM/dd/yyyy'), regexMatch(trim(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'MM-dd-yy'), regexMatch(trim(payment_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(payment_date), 'dd-MMM-yyyy'), regexMatch(trim(payment_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(payment_date), 'MMMM dd, yyyy'))) ~> convertirMontoFecha",
				"convertirMontoFecha, admisionesSilver exists(limpiarTextos@admission_id == admisionesSilver@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> existeAdmision",
				"existeAdmision filter(!isNull(billing_id) && !isNull(amount)) ~> soloValidos",
				"soloValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> silverBilling"
			]
		}
	}
}