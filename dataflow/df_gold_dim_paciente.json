{
	"name": "df_gold_dim_paciente",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "pacientes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_gold_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "goldDimPaciente"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT patient_id AS patient_id_bk,\\n       full_name AS nombre_completo,\\n       CASE gender WHEN \\'Male\\' THEN \\'Masculino\\' WHEN \\'Female\\' THEN \\'Femenino\\' ELSE \\'Otro\\' END AS genero,\\n       date_of_birth AS fecha_nacimiento,\\n       CASE\\n           WHEN date_of_birth IS NULL THEN \\'Sin dato\\'\\n           WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) <= 18 THEN \\'0-18\\'\\n           WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) <= 35 THEN \\'19-35\\'\\n           WHEN DATEDIFF(YEAR, date_of_birth, GETDATE()) <= 60 THEN \\'36-60\\'\\n           ELSE \\'60+\\'\\n       END AS rango_etario,\\n       email AS correo_electronico,\\n       address AS direccion,\\n       COALESCE(insurance_provider, \\'Sin seguro\\') AS proveedor_seguro\\nFROM silver.patients',",
				"     format: 'query') ~> pacientes",
				"pacientes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id_bk,",
				"          nombre_completo,",
				"          genero,",
				"          fecha_nacimiento,",
				"          rango_etario,",
				"          correo_electronico,",
				"          direccion,",
				"          proveedor_seguro",
				"     )) ~> goldDimPaciente"
			]
		}
	}
}